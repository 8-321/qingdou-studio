.bluecard{background:#EEF3FF;border-color:#DCE7FF;box-shadow:none}
.usage{padding:14rpx 0}
.usage + .usage{border-top:1rpx solid #ECECEE}
.keyrow{display:flex;align-items:center;gap:16rpx;padding:18rpx 0}
.keyrow + .keyrow{border-top:1rpx solid #ECECEE}
.badge{width:76rpx;height:52rpx;border-radius:12rpx;background:#F6F7F9;color:#5B616B;font-size:20rpx;font-weight:600;display:flex;align-items:center;justify-content:center;flex:none}
.plat.on{background:#0A0A0B;color:#fff}
.label{font-size:22rpx;color:#8A8F98}
.inp{height:84rpx;border:1rpx solid #ECECEE;border-radius:16rpx;padding:0 20rpx;font-size:26rpx;background:#fff;margin-top:8rpx}
.mask{position:fixed;top:0;right:0;bottom:0;left:0;background:rgba(10,10,11,.36);z-index:90;display:flex;align-items:flex-end}
.sheet{width:100%;background:#fff;border-radius:32rpx 32rpx 0 0;padding:32rpx 40rpx 56rpx;box-sizing:border-box;max-height:86vh;overflow:auto}
.tinybtn{padding:0 16rpx}
