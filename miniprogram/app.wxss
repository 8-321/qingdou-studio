page{
  --paper:#FFFFFF; --paper2:#F6F7F9; --card:#FFFFFF;
  --ink:#0A0A0B; --ink2:#5B616B; --ink3:#8A8F98; --line:#ECECEE;
  --blue:#2563EB; --blueSoft:#EEF3FF; --green:#0B7A4B; --greenSoft:#E8F5EF;
  --red:#D93025; --redSoft:#FDECEA;
  background:var(--paper); color:var(--ink);
  font-family:-apple-system,"PingFang SC","HarmonyOS Sans SC",sans-serif;
  font-size:28rpx; line-height:1.6;
}
.wrap{padding:24rpx 40rpx 60rpx}
.h1{font-size:54rpx;font-weight:600;line-height:1.24;letter-spacing:-1rpx}
.h2{font-size:40rpx;font-weight:600;letter-spacing:-.6rpx}
.h3{font-size:30rpx;font-weight:600}
.sub{font-size:24rpx;color:var(--ink2)}
.tiny{font-size:22rpx;color:var(--ink3)}
.mono{font-family:Menlo,Consolas,monospace;font-size:20rpx;letter-spacing:1.6rpx;color:var(--ink3)}
.center{text-align:center}
.row{display:flex;align-items:center}
.between{display:flex;align-items:center;justify-content:space-between}
.grow{flex:1;min-width:0}
.mt{margin-top:24rpx}.mt8{margin-top:16rpx}.mt12{margin-top:24rpx}
.card{background:var(--card);border:1rpx solid var(--line);border-radius:32rpx;padding:28rpx;box-shadow:0 2rpx 6rpx rgba(10,10,11,.03)}
.card.flat{background:var(--paper2);border-color:transparent;box-shadow:none}
.pill{display:inline-flex;align-items:center;height:52rpx;padding:0 22rpx;border-radius:999rpx;font-size:22rpx;font-weight:600}
.pill.blue{background:var(--blueSoft);color:var(--blue)}
.pill.moss{background:var(--greenSoft);color:var(--green)}
.pill.gold{background:var(--paper2);color:var(--ink2)}
.pill.verm{background:var(--ink);color:#fff}
.pill.line{border:1rpx solid var(--line);color:var(--ink2)}
.pill.sm{height:40rpx;font-size:20rpx;padding:0 14rpx}
.btn{height:96rpx;border-radius:24rpx;font-size:30rpx;font-weight:600;display:flex;align-items:center;justify-content:center;border:none}
.btn::after{border:none}
.btn.primary{background:var(--ink);color:#fff}
.btn.verm{background:var(--ink);color:#fff}
.btn.blue{background:var(--blue);color:#fff}
.btn.ghost{background:transparent;border:1rpx solid var(--ink);color:var(--ink)}
.btn.sm{height:68rpx;font-size:24rpx;border-radius:18rpx;padding:0 26rpx;width:auto}
.paste{width:100%;height:190rpx;font-size:28rpx;line-height:1.7;background:var(--paper);border:2rpx dashed #D8DADF;border-radius:24rpx;padding:24rpx;box-sizing:border-box}
.platrow{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:20rpx}
.plat{height:48rpx;line-height:48rpx;padding:0 16rpx;border-radius:12rpx;background:var(--paper2);font-size:22rpx;color:var(--ink2)}
.task{display:flex;align-items:center;gap:20rpx;padding:20rpx 0;border-bottom:1rpx solid var(--line)}
.task:last-child{border-bottom:none}
.thumb{width:92rpx;height:92rpx;border-radius:18rpx;background:var(--ink);color:#fff;font-size:20rpx;display:flex;align-items:center;justify-content:center;flex:none}
.t1{font-size:28rpx;line-height:1.45;font-weight:600;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
.quote{font-size:30rpx;line-height:1.7}
.tag{display:inline-block;height:36rpx;line-height:36rpx;padding:0 12rpx;border-radius:8rpx;font-size:20rpx;font-weight:600;margin-right:10rpx;color:#fff;background:var(--ink)}
.tag.hook{background:var(--blue)}.tag.pain{background:var(--ink)}.tag.proof{background:var(--green)}.tag.turn{background:#6B7280}
.seg{display:flex;gap:16rpx;padding:20rpx 12rpx;border-radius:16rpx}
.seg.on{background:var(--blueSoft)}
.seg .t{width:66rpx;flex:none;font-family:Menlo,Consolas,monospace;font-size:20rpx;color:var(--ink3);padding-top:6rpx}
.seg .tx{font-size:30rpx;line-height:1.75}
.empty{padding:80rpx 0;text-align:center;color:var(--ink3);font-size:24rpx}
.dot{width:16rpx;height:16rpx;border-radius:50%;background:var(--blue);flex:none}
.bar{height:8rpx;background:var(--line);border-radius:999rpx;overflow:hidden}
.bar > view{height:8rpx;background:var(--blue);border-radius:999rpx}
